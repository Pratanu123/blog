APP_NAME=BlogCMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=blog
DB_USERNAME=blog_user
DB_PASSWORD=blog_password
MYSQL_ROOT_PASSWORD=root_password

REDIS_HOST=redis
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173

VITE_API_URL=/api

# Production-only (used by docker-compose.prod.yml). Leave unset for local.
# NGINX_CONF=production-http.conf
# APP_URL=https://inkandvoltage.com
# SANCTUM_STATEFUL_DOMAINS=inkandvoltage.com,www.inkandvoltage.com
# CORS_ALLOWED_ORIGINS=https://inkandvoltage.com,https://www.inkandvoltage.com
# SESSION_SECURE_COOKIE=true
